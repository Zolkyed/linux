# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# File operations
alias mkdir='mkdir -p'
alias mv='mv -v'
alias rm='rm -v'
alias rmd='rm -vr'
alias cp='cp -v'
alias cpd='cp -vr'

# Editor
alias v='nvim'
alias vi='nvim'
alias vim='nvim'

# Git
alias gl='git log --oneline --graph --decorate'
alias gs='git status -sb'
alias gd='git diff'
alias gco='git checkout'
