{
  "editor.tokenColorCustomizations": {
    "[Default Dark Modern]": {
      "textMateRules": [
        {
          "scope": ["meta.embedded", "source.groovy.embedded"],
          "settings": {
            "foreground": "#D4D4D4",
          },
        },
        {
          "scope": [
            "entity.name.type.class",
            "entity.other.inherited-class",
            "support.class",
          ],
          "settings": {
            "foreground": "#4EC9B0",
          },
        },
        {
          "scope": ["storage.type", "keyword.operator.new", "keyword.control"],
          "settings": {
            "foreground": "#ff7b72",
          },
        },
        {
          "scope": "entity.name.function",
          "settings": {
            "foreground": "#d2a8ff",
          },
        },
        {
          "scope": "support.variable.property",
          "settings": {
            "foreground": "#4FC1FF",
          },
        },
        {
          "scope": ["support.variable", "support.function"],
          "settings": {
            "foreground": "#ffa657",
          },
        },
      ],
    },
    "[Dark Modern Darker]": {
      "textMateRules": [
        {
          "scope": ["meta.embedded", "source.groovy.embedded"],
          "settings": {
            "foreground": "#D4D4D4",
          },
        },
        {
          "scope": [
            "entity.name.type.class",
            "entity.other.inherited-class",
            "support.class",
          ],
          "settings": {
            "foreground": "#4EC9B0",
          },
        },
        {
          "scope": ["storage.type", "keyword.operator.new", "keyword.control"],
          "settings": {
            "foreground": "#ff7b72",
          },
        },
        {
          "scope": "entity.name.function",
          "settings": {
            "foreground": "#d2a8ff",
          },
        },
        {
          "scope": "support.variable.property",
          "settings": {
            "foreground": "#4FC1FF",
          },
        },
        {
          "scope": ["support.variable", "support.function"],
          "settings": {
            "foreground": "#ffa657",
          },
        },
      ],
    },
  },

  // background
  "workbench.colorCustomizations": {
    "[Default Dark Modern]": {
      "editor.background": "#181818",
    },
    "[Dark Modern Darker]": {
      "editor.background": "#121212",
    },
    // scrollbar (https://stackoverflow.com/questions/59002585/how-can-i-remove-symbols-on-right-scrollbar-of-vscode)
    // "editorOverviewRuler.addedForeground": "#0000",
    // "editorOverviewRuler.modifiedForeground": "#0000",
    // "editorOverviewRuler.deletedForeground": "#0000",
    // "editorOverviewRuler.warningForeground": "#0000",
    // "editorOverviewRuler.errorForeground": "#0000",
    "editorOverviewRuler.infoForeground": "#0000",
    "editorOverviewRuler.bracketMatchForeground": "#0000",
    "editorOverviewRuler.commentForeground": "#0000",
    "editorOverviewRuler.commentUnresolvedForeground": "#0000",
    "editorOverviewRuler.currentContentForeground": "#0000",
    "editorOverviewRuler.commonContentForeground": "#0000",
    "editorOverviewRuler.incomingContentForeground": "#0000",
    "editorOverviewRuler.findMatchForeground": "#0000",
    "editorOverviewRuler.rangeHighlightForeground": "#0000",
    "editorOverviewRuler.selectionHighlightForeground": "#0000",
    "editorOverviewRuler.wordHighlightForeground": "#0000",
    "editorOverviewRuler.wordHighlightStrongForeground": "#0000",
    "editorOverviewRuler.wordHighlightTextForeground": "#0000",
  },
  "editor.hideCursorInOverviewRuler": true,
  "debug.showBreakpointsInOverviewRuler": true,
  "editor.minimap.enabled": false,
  "editor.scrollbar.verticalScrollbarSize": 13,
  "editor.scrollbar.vertical": "auto",
  "editor.scrollbar.horizontalScrollbarSize": 10,
  "editor.scrollbar.horizontal": "auto",

  // zoom
  "window.zoomLevel": -1,
  "editor.mouseWheelZoom": false,
  "editor.smoothScrolling": false,

  // icons
  "workbench.iconTheme": "material-icon-theme",

  // color brackets
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": true, // (____)
  "editor.guides.highlightActiveBracketPair": true,
  "editor.guides.highlightActiveIndentation": "always",

  // cursor
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "solid",
  "editor.cursorWidth": 2,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.cursorStyleInactive": "none",
  "terminal.integrated.cursorWidth": 2,

  // editor
  "editor.fontFamily": "Fira Code",
  "editor.renderLineHighlight": "all",
  "editor.renderWhitespace": "none",
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": false,

  // terminal
  "workbench.panel.defaultLocation": "right",
  "terminal.integrated.fontFamily": "FiraCode Nerd Font",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.profiles.windows": {
    "Git Bash": {
      "path": "C:\\Program Files\\Git\\bin\\bash.exe"
    }
  },
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.hideCondition": "never",
  "terminal.integrated.tabs.location": "right",
  "terminal.integrated.tabs.title": "${process}",
  "terminal.integrated.stickyScroll.enabled": false,

  // debug
  "debug.toolBarLocation": "docked",
  "debug.inlineValues": "on",

  // workspace
  "workbench.layoutControl.enabled": false,
  "workbench.settings.editor": "json",
  "workbench.startupEditor": "none",
  "workbench.welcomePage.walkthroughs.openOnInstall": false,
  "workbench.editor.openOnFocus": false,
  "workbench.activityBar.location": "default",
  "workbench.tips.enabled": false,
  "window.commandCenter": false,
  "window.title": " ",
  "chat.commandCenter.enabled": false,

  // file tree
  "workbench.tree.renderIndentGuides": "always",

  // breadcrumbs
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "last",
  "breadcrumbs.symbolPath": "on",

  // suggestions
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.quickSuggestionsDelay": 0,

  // explorer
  "explorer.confirmDelete": false,
  "explorer.confirmPasteNative": false,
  "explorer.confirmDragAndDrop": false,

  // security
  "security.workspace.trust.banner": "never",
  "security.workspace.trust.startupPrompt": "never",
  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.enabled": false,

  // indentation
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,

  // format
  "editor.formatOnPaste": true,
  "editor.formatOnSave": false,
  "editor.formatOnType": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
  },
  "[less]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt",
    "editor.tabSize": 2,
    "shfmt.indent": 2,
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
  },
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
  },

  // javascript / typescript
  "javascript.inlayHints.parameterNames.enabled": "literals",
  "javascript.inlayHints.functionLikeReturnTypes.enabled": true,
  "javascript.inlayHints.enumMemberValues.enabled": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.tsserver.maxTsServerMemory": 4096,

  // python
  "python.analysis.inlayHints.callArgumentNames": "partial",
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.typeCheckingMode": "basic",
  "python.terminal.executeInFileDir": true,
  "jupyter.notebookFileRoot": "${workspaceFolder}/notebooks",

  // html
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
  },

  // markdown
  "markdown.preview.scrollEditorWithPreview": true,
  "markdown.preview.scrollPreviewWithEditor": true,

  // excludes
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/tmp/**": true,
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/bower_components": true,
    "**/dist/**": true,
    "**/log/**": true,
    "**/logs/**": true,
    "**/.fdk/**": true,
    "**/__pycache__/**": true,
    "**/.terraform/**": true,
    "**/.venv/**": true,
    "**/.ruff_cache/**": true,
  },
  "files.exclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/tmp/**": true,
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/bower_components": true,
    "**/dist/**": true,
    "**/log/**": true,
    "**/logs/**": true,
    "**/.fdk/**": true,
    "**/__pycache__/**": true,
    "**/.terraform/**": true,
    "**/.venv/**": true,
    "**/.ruff_cache/**": true,
  },
  "search.exclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/tmp/**": true,
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/bower_components": true,
    "**/dist/**": true,
    "**/log/**": true,
    "**/logs/**": true,
    "**/.fdk/**": true,
    "**/__pycache__/**": true,
    "**/.terraform/**": true,
    "**/.venv/**": true,
    "**/.ruff_cache/**": true,
  },

  // git
  "scm.alwaysShowRepositories": true,
  "git.suggestSmartCommit": false,
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.pruneOnFetch": true,
  "git.autoRepositoryDetection": "subFolders",
  "git.detectWorktrees": true,
  "git.repositoryScanMaxDepth": 4,
  "git.showActionButton": {
    "commit": true,
    "publish": true,
    "sync": true,
  },
  "git.mergeEditor": true,
  "diffEditor.codeLens": true,

  // files
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 500,
  "files.saveConflictResolution": "askUser",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // github copilot
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "chat.useAgentsMdFile": true,
  "chat.useCustomizationsInParentRepositories": true,
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Use Conventional Commits: <type>[optional scope][!]: <description>."
    },
    {
      "text": "Use only: feat, fix, docs, perf, refactor, test, chore, ci, or build."
    },
    {
      "text": "Write a concise lowercase imperative description without a trailing period."
    },
    {
      "text": "Describe the purpose of the complete staged change, not individual files."
    },
  ],
  "github.copilot.chat.pullRequestDescriptionGeneration.instructions": [
    {
      "text": "Use a concise lowercase Conventional Commit title: <type>[optional scope][!]: <description>."
    },
    {
      "text": "Use only: feat, fix, docs, perf, refactor, test, chore, ci, or build."
    },
    {
      "text": "Structure the description with Summary, Closes #<issue>, Changes, Verification, and Risks sections."
    },
    {
      "text": "Explain what changed, why it changed, validation performed, and any risks."
    },
  ],
  "github.copilot.chat.reviewSelection.instructions": [
    {
      "text": "Prioritize correctness, security, regressions, edge cases, missing tests, convention violations, and unnecessary changes."
    },
  ],
}
